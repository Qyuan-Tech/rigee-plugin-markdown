{
  "name": "rigee-plugin-markdown",
  "version": "1.0.1",
  "private": true,
  "description": "A Markdown preview for Rigee — GitHub-flavoured, and kept current as the file changes on disk.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Qyuan-Tech/rigee-plugin-markdown",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qyuan-Tech/rigee-plugin-markdown.git"
  },
  "packageManager": "pnpm@10.29.2",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc",
    "release:pack": "pnpm run typecheck && pnpm run build && npm pack"
  },
  "devDependencies": {
    "@rigee/plugin-api": "^0.2.0",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "cordis": "4.0.0-rc.10",
    "dompurify": "3.4.16",
    "electron": "44.4.1",
    "esbuild": "0.28.2",
    "marked": "18.1.0",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  },
  "rigee": {
    "id": "markdown",
    "version": "1.0.1",
    "displayName": "Markdown Preview",
    "description": "Read a Markdown file the way it renders — GitHub-flavoured, and kept current as it changes on disk.",
    "apiVersion": 1,
    "minAppVersion": "1.1.0",
    "permissions": ["files:read", "net"],
    "main": "dist/main.js",
    "renderer": "dist/renderer.js",
    "contributes": {
      "editors": [
        {
          "viewType": "markdown.preview",
          "displayName": "Markdown Preview",
          "icon": "preview",
          "selector": { "extensions": ["md", "markdown", "mdown", "markdn", "mkd", "mkdn", "mdwn", "mdtxt", "mdtext"] },
          "onRequest": { "label": "Open Preview", "tabPrefix": "Preview" }
        }
      ]
    }
  }
}
